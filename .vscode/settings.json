{
  "i18n-ally.localesPaths": [
    "src/i18n",
    "modules/Apartments/i18n",
    "modules/Calendar/i18n",
    "modules/Guests/i18n",
    "modules/LoginPage/i18n",
    "modules/PublicCalendar/i18n",
    "modules/Calendar/CreateNewEvent/i18n",
    "modules/Calendar/DayDetails/i18n",
    "modules/Guests/GuestsModal/i18n",
    "modules/Invoice/InvoiceInputs/i18n",
    "modules/Invoice/PDFDownload/i18n",
    "modules/Invoice/Templates/i18n",
    "modules/PublicCalendar/CreateNewReservation/i18n",
    "modules/Shared/AlertModal/i18n",
    "modules/Shared/DatePicker/i18n",
    "modules/Shared/DateRangePicker/i18n",
    "modules/Shared/Inputs/i18n",
    "modules/Shared/Navbar/i18n",
    "app/[locale]/(protected)/invoice/_fragments/i18n"
  ],
  "i18n-ally.autoDetection": true,
  "i18n-ally.dirStructure": "auto",
  "i18n-ally.enabledFrameworks": ["next-intl"],
  "i18n-ally.enabledParsers": ["js", "json"],
  "i18n-ally.namespace": true,
  "i18n-ally.pathMatcher": "{namespace}.{locale}.{ext}",
  "i18n-ally.keystyle": "nested",
  "i18n-ally.translate.engines": ["google"],
  "i18n-ally.translate.parallels": 5,
  "i18n-ally.annotations": true,
  "i18n-ally.theme.annotation": "rgba(153, 153, 153, .8)",
  "i18n-ally.theme.annotationBorder": "rgba(153, 153, 153, .8)",
  "i18n-ally.theme.annotationMissing": "#d37070",
  "i18n-ally.theme.annotationMissingBorder": "#d37070",
  "i18n-ally.displayLanguage": "en-US",
  "i18n-ally.sourceLanguage": "en-US",
}
