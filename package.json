{
  "name": "booking-calendar-next",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "predev": "yarn run translations:watch &",
    "dev": "next dev",
    "prebuild": "yarn translations:compile",
    "build": "next build",
    "build:Windows": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:api": "curl http://localhost:8000/api-docs-json > ./src/api/openapi.json && rm -rf ./src/api/openapi-schemas && rm -rf ./src/api/openapi-config && npx orval --config ./src/api/orval.config.ts && npx prettier --write ./src/api/ && rm ./src/api/openapi.json",
    "translations:compile": "node compile-translations.mjs",
    "translations:watch": "find modules ui -name '*.json' | entr node compile-translations.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-collapsible": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-pdf/renderer": "^4.0.0",
    "@sendgrid/mail": "^8.1.3",
    "@tanstack/query-sync-storage-persister": "^5.56.2",
    "@tanstack/react-query": "^5.56.2",
    "@tanstack/react-query-persist-client": "^5.56.2",
    "@tanstack/react-table": "^8.20.5",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.8.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "lucide-react": "^0.446.0",
    "luxon": "^3.5.0",
    "next": "14.2.13",
    "next-intl": "3.20.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-pdf": "^9.1.1",
    "react-toastify": "^10.0.5",
    "sass": "^1.79.3",
    "sharp": "^0.33.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.2.13",
    "@svgr/webpack": "^8.1.0",
