{
  "name": "booking-calendar-next",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "predev": "yarn run translations:watch &",
    "dev": "next dev",
    "prebuild": "yarn translations:compile",
    "build": "next build",
    "build:Windows": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate:api": "curl http://localhost:8000/api-docs-json > ./src/api/openapi.json && rm -rf ./src/api/openapi-schemas && rm -rf ./src/api/openapi-config && npx orval --config ./src/api/orval.config.ts && npx prettier --write ./src/api/ && rm ./src/api/openapi.json",
    "translations:compile": "node compile-translations.mjs",
    "translations:watch": "find modules ui -name '*.json' | entr node compile-translations.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^3.1.11",
    "@reduxjs/toolkit": "^1.9.5",
    "@sendgrid/mail": "^7.7.0",
    "@tanstack/query-sync-storage-persister": "^5.28.9",
    "@tanstack/react-query": "^5.28.9",
    "@tanstack/react-query-persist-client": "^5.28.9",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "firebase": "^9.22.1",
    "framer-motion": "^10.12.16",
    "i18next": "^22.5.0",
    "i18next-intervalplural-postprocessor": "^3.0.0",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "luxon": "^3.4.4",
    "next": "^14.1.4",
    "next-i18next": "^13.2.2",
    "next-intl": "^3.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^12.3.1",
    "react-pdf": "^7.0.3",
    "react-redux": "^8.0.7",
    "react-toastify": "^10.0.5",
    "redux-persist": "^6.0.0",
    "sass": "^1.62.1",
    "sharp": "^0.32.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.1.4",
    "@svgr/webpack": "^8.0.1",
    "@tanstack/react-query-devtools": "^5.28.10",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/js-cookie": "^3.0.3",
    "@types/lodash": "^4.17.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "20.12.2",
    "@types/react": "18.2.73",
    "@types/react-dom": "18.2.23",
    "@types/react-pdf": "^6.2.0",
    "@types/webpack-env": "^1.18.4",
    "@typescript-eslint/parser": "^7.4.0",
    "@vercel/node": "^2.14.5",
    "autoprefixer": "^10.4.19",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.4",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "file-loader": "^6.2.0",
    "firebase-tools": "^12.3.0",
    "orval": "^6.25.0",
    "postcss": "^8.4.24",
    "prettier": "^2.8.8",
    "prettier-plugin-css-order": "^1.3.0",
    "prettier-plugin-tailwindcss": "^0.3.0",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.3"
  }
}
