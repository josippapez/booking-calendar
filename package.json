    "@types/webpack-env": "^1.18.5",
    "@typescript-eslint/parser": "^8.7.0",
    "@vercel/node": "^3.2.16",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.13",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.30.0",
    "file-loader": "^6.2.0",
    "orval": "^7.1.1",
    "postcss": "^8.4.47",
